{
	"name": "notes-archive",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test:unit": "vitest run --reporter=verbose",
		"test:e2e": "playwright test --reporter=list",
		"proof": "npm run check && npm run build && npm run test:unit",
		"proof:full": "npm run proof && npm run test:e2e",
		"package": "npm run build && node scripts/package.mjs"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	},
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@tiptap/core": "3.32.2",
		"@tiptap/extension-bubble-menu": "3.32.2",
		"@tiptap/extension-code": "3.32.2",
		"@tiptap/extension-code-block-lowlight": "3.32.2",
		"@tiptap/extension-details": "3.32.2",
		"@tiptap/extension-drag-handle": "3.32.2",
		"@tiptap/extension-file-handler": "3.32.2",
		"@tiptap/extension-list": "3.32.2",
		"@tiptap/extension-table": "3.32.2",
		"@tiptap/extension-text-style": "3.32.2",
		"@tiptap/extensions": "3.32.2",
		"@tiptap/pm": "3.32.2",
		"@tiptap/starter-kit": "3.32.2",
		"@tiptap/suggestion": "3.32.2",
		"lowlight": "^3.3.0",
		"sharp": "^0.35.5"
	}
}
